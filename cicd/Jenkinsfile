pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'nikhilreddy810/kubeheal'
        CHART_DIR    = 'helm/kubeheal'
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Code Quality & Lint') {
            steps {
                echo 'Running Helm chart validation and Python lint...'
                sh 'helm lint ${CHART_DIR}'
            }
        }

        stage('Build Container Image') {
            steps {
                echo 'Building KubeHeal container image...'
                sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest agent/'
            }
        }

        stage('Helm Dry-Run Verification') {
            steps {
                echo 'Executing Helm dry-run and template verification...'
                sh 'helm upgrade --install kubeheal ${CHART_DIR} --dry-run --debug'
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                echo 'Deploying KubeHeal to Kubernetes cluster...'
                sh 'helm upgrade --install kubeheal ${CHART_DIR} --namespace default'
            }
        }
    }

    post {
        success {
            echo '✅ KubeHeal CI/CD Pipeline executed successfully!'
        }
        failure {
            echo '❌ Pipeline failed! Check logs above.'
        }
    }
}
