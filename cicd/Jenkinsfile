pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'nikhilreddy810/kubeheal'
        APP_PORT     = '8090'
    }

    stages {
        stage('Lint & Static Analysis') {
            steps {
                echo 'Running Python syntax verification and dependency validation...'
                sh 'python3 -m py_compile app/main.py app/watcher.py app/triage_engine.py app/models.py'
            }
        }

        stage('Container Build') {
            steps {
                echo "Building lightweight Python multi-stage container image..."
                sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest .'
            }
        }

        stage('Security Scan (Trivy)') {
            steps {
                echo 'Executing Trivy vulnerability scan against container filesystem...'
                sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --severity HIGH,CRITICAL ${DOCKER_IMAGE}:${BUILD_NUMBER} || true'
            }
        }

        stage('Helm Chart Validation') {
            steps {
                echo 'Linting Helm 3 templates...'
                sh 'helm lint ./helm/kubeheal'
            }
        }

        stage('Argo CD GitOps Sync') {
            steps {
                echo 'Commit and push image tag update to GitOps repository for automated Argo CD synchronization.'
            }
        }
    }

    post {
        always {
            echo "CI/CD Pipeline Run Completed."
        }
    }
}
